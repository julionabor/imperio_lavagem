# ── Base de dados ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pm:pm@localhost:5432/pm_dev"
DATABASE_URL_TEST="postgresql://pm:pm@localhost:5432/pm_test"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="muda-isto-em-producao-pelo-menos-32-caracteres!!"
JWT_REFRESH_SECRET="muda-isto-em-producao-pelo-menos-32-caracteres!!"

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# URL do site Angular (para CORS) — em produção: https://privatemotors.pt
WEB_URL="http://localhost:4200"

# ── Armazenamento de imagens ──────────────────────────────────────────────────
# Em produção, montar o volume Railway em /data/uploads e definir esta variável
UPLOAD_DIR="./uploads"

# ── Email ─────────────────────────────────────────────────────────────────────
# "console" → escreve no log (dev).
# Em produção: URL SMTP completa, ex.: smtps://user:pass@smtp.brevo.com:465
EMAIL_TRANSPORT=console
EMAIL_FROM="Private Motors <noreply@privatemotors.pt>"
